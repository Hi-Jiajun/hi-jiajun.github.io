---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="标签" description="按技术主题浏览所有博客文章。">
  <div class="article-header">
    <p class="hero-kicker">TAGS · {tags.length} TOPICS</p>
    <h1>标签索引</h1>
  </div>

  <div class="tag-row" style="gap: 0.65rem;">
    {tags.map(({ tag, count }) => (
      <a class="tag-pill" style="padding: 0.35rem 0.85rem; font-size: 0.92rem;" href={`/tags/${encodeURIComponent(tag)}/`}>
        #{tag} <span style="opacity:0.7">({count})</span>
      </a>
    ))}
  </div>
</BaseLayout>
