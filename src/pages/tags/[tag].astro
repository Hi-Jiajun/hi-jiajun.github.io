---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllTags, getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  posts: Awaited<ReturnType<typeof getPublishedPosts>>;
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签: #${tag}`} description={`标签 #${tag} 下的全部文章（共 ${posts.length} 篇）。`}>
  <div class="article-header">
    <p class="hero-kicker">TAG · {posts.length} POSTS</p>
    <h1>#{tag}</h1>
    <p style="margin: 0.4rem 0 0; color: var(--muted);">
      <a href="/tags/">← 返回全部标签</a>
    </p>
  </div>

  <div class="post-list">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
