---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { PROJECTS, SITE } from '../config';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 8);
const featuredProjects = PROJECTS.filter((p) => p.featured);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="hero">
    <p class="hero-kicker">HI-JIAJUN · KILIMINAL / PUBLIC WORKBENCH</p>
    <h1>{SITE.titleZh}</h1>
    <p>
      记录用户态网络数据面（VPP）、macOS 与 Linux 内核驱动移植、小米 15S Pro（XRING O1）设备树与无线实验、
      以及 Metal-on-Vulkan / AI 自动化工具链的真实进展与边界。
    </p>
    <div class="hero-actions">
      <a class="pill-btn primary" href="/posts/">阅读全部文章 ({posts.length})</a>
      <a class="pill-btn" href="/projects/">项目索引</a>
      <a class="pill-btn" href="/search/">全文搜索</a>
      <a class="pill-btn" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub 主页</a>
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>最新文章</h2>
      <a class="more-link" href="/posts/">全部文章 →</a>
    </div>
    <div class="post-list">
      {recentPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>代表项目</h2>
      <a class="more-link" href="/projects/">查看全部 {PROJECTS.length} 个项目 →</a>
    </div>
    <div class="grid-2">
      {featuredProjects.map((project) => (
        <article class="card">
          <div class="project-card-top">
            <a class="project-title" href={project.repo} target="_blank" rel="noopener noreferrer">
              {project.name}
            </a>
            <span class="badge">{project.language}</span>
          </div>
          <p>{project.summary}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
