---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllTags, getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);

const grouped = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  const list = grouped.get(year) ?? [];
  list.push(post);
  grouped.set(year, list);
}
const years = Array.from(grouped.entries()).sort((a, b) => b[0] - a[0]);
---

<BaseLayout title="文章归档" description="所有已发布的博客文章与技术笔记归档。">
  <div class="article-header">
    <p class="hero-kicker">ARCHIVE · {posts.length} POSTS</p>
    <h1>文章归档</h1>
    {tags.length > 0 && (
      <div class="tag-row">
        {tags.slice(0, 12).map(({ tag, count }) => (
          <a class="tag-pill" href={`/tags/${encodeURIComponent(tag)}/`}>
            #{tag} <span style="opacity:0.7">({count})</span>
          </a>
        ))}
      </div>
    )}
  </div>

  {years.map(([year, yearPosts]) => (
    <section>
      <div class="section-head">
        <h2>{year}</h2>
        <span class="more-link">{yearPosts.length} 篇</span>
      </div>
      <div class="post-list">
        {yearPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
