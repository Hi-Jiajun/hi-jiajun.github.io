---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="站内搜索" description="实时搜索全部文章标题、标签与正文内容。">
  <div class="article-header">
    <p class="hero-kicker">INSTANT SEARCH</p>
    <h1>搜索文章</h1>
  </div>

  <div class="search-input-wrap">
    <input
      id="search-input"
      class="search-input"
      type="search"
      placeholder="输入关键词，例如 VPP、XRING、macOS、Vulkan…"
      autocomplete="off"
      autofocus
    />
  </div>

  <p id="search-status" class="search-status">正在加载索引…</p>
  <div id="search-results" class="post-list"></div>

  <script is:inline>
    (() => {
      const input = document.getElementById('search-input');
      const status = document.getElementById('search-status');
      const results = document.getElementById('search-results');
      if (!input || !status || !results) return;

      let docs = [];

      function escapeHtml(str) {
        return str
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function render(query) {
        const q = query.trim().toLowerCase();
        const terms = q ? q.split(/\s+/).filter(Boolean) : [];
        const matched = terms.length
          ? docs.filter((doc) => {
              const haystack = `${doc.title}\n${doc.tags.join(' ')}\n${doc.summary}\n${doc.content}`.toLowerCase();
              return terms.every((t) => haystack.includes(t));
            })
          : docs;

        status.textContent = terms.length
          ? `找到 ${matched.length} 篇匹配文章`
          : `共索引 ${docs.length} 篇文章，输入关键词即可过滤`;

        if (!matched.length) {
          results.innerHTML = '<div class="card"><p>没有找到匹配的文章，试试更换关键词。</p></div>';
          return;
        }

        results.innerHTML = matched
          .map((doc) => {
            const tagsHtml = (doc.tags || [])
              .map((t) => `<a class="tag-pill" href="/tags/${encodeURIComponent(t)}/">#${escapeHtml(t)}</a>`)
              .join('');
            return `
              <article class="post-item">
                <div class="post-meta"><time>${escapeHtml(doc.date)}</time></div>
                <h3><a href="/posts/${encodeURIComponent(doc.slug)}/">${escapeHtml(doc.title)}</a></h3>
                <p class="post-summary">${escapeHtml(doc.summary)}</p>
                ${tagsHtml ? `<div class="tag-row">${tagsHtml}</div>` : ''}
              </article>
            `;
          })
          .join('');
      }

      fetch('/search-index.json')
        .then((res) => res.json())
        .then((data) => {
          docs = Array.isArray(data) ? data : [];
          const params = new URLSearchParams(window.location.search);
          const initial = params.get('q') || '';
          if (initial) input.value = initial;
          render(input.value);
        })
        .catch(() => {
          status.textContent = '搜索索引加载失败，请刷新重试。';
        });

      input.addEventListener('input', () => render(input.value));
    })();
  </script>
</BaseLayout>
