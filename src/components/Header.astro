---
import { SITE } from '../config';

const path = Astro.url.pathname;
const navItems = [
  { href: '/posts/', label: '文章', match: '/posts' },
  { href: '/projects/', label: '项目', match: '/projects' },
  { href: '/tags/', label: '标签', match: '/tags' },
  { href: '/search/', label: '搜索', match: '/search', kbd: '/' },
  { href: '/about/', label: '关于', match: '/about' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">&gt;_</span>
      <span>{SITE.titleShort}</span>
    </a>

    <nav class="nav-wrap" aria-label="主导航">
      {navItems.map((item) => {
        const isActive = path.startsWith(item.match);
        return (
          <a class:list={['nav-link', { active: isActive }]} href={item.href}>
            <span>{item.label}</span>
            {item.kbd && <span class="kbd-hint">{item.kbd}</span>}
          </a>
        );
      })}

      <a class="icon-btn" href="/rss.xml" title="RSS 订阅" aria-label="RSS 订阅">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
      </a>

      <a class="icon-btn" href={SITE.github} target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub 主页">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <button id="theme-toggle" class="icon-btn" type="button" title="切换浅色 / 深色主题" aria-label="切换浅色 / 深色主题">
        <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" /><path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" /><path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
        </svg>
      </button>
    </nav>
  </div>
</header>
