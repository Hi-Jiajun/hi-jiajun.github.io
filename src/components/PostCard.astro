---
import {
  type BlogPost,
  estimateReadingTime,
  extractExcerpt,
  formatDate,
  getPostSlug,
} from '../utils/posts';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const slug = getPostSlug(post);
const summary = post.data.summary ?? extractExcerpt(post.body);
const { minutes } = estimateReadingTime(post.body);
---

<article class="post-item">
  <div class="post-meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span>·</span>
    <span>约 {minutes} 分钟阅读</span>
  </div>
  <h3>
    <a href={`/posts/${slug}/`}>{post.data.title}</a>
  </h3>
  {summary && <p class="post-summary">{summary}</p>}
  {post.data.tags.length > 0 && (
    <div class="tag-row">
      {post.data.tags.map((tag) => (
        <a class="tag-pill" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
      ))}
    </div>
  )}
</article>
